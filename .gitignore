# Local runtime data: these directories contain all user-owned state.
/site/data/
/we-mp-rss/data/

# Local configuration and credentials (legacy locations included defensively).
/we-mp-rss/config.yaml
/.env
/.env.*
**/.env
**/.env.*
!**/.env.example

# Databases, backups, logs, keys, cookies, and generated authorization files.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
*.pem
*.key
*.lic
*.cookie
*.cookies
*.secret
*.bak
*.backup
*.tmp
.~lock.*#

# Private imports/exports and generated QR codes.
**/private/
**/exports/
**/backups/
**/wx_qrcode.png
**/tmp_shot_qr.png
**/*接入清单*.csv

# Dependencies, environments, caches, and build state.
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.next/
**/.vinext/
**/.wrangler/
**/.sites-runtime/
**/.arts/

# Machine-specific editor and agent state.
**/.DS_Store
**/.idea/
**/.vscode/
**/.agents/
**/.codex/
**/outputs/
**/work/

# Internal hosting metadata and release archives.
/site/.openai/hosting.json
/site-deploy*.tar.gz
/site-deploy*.zip
/release/
/packaging/.build/

# JavaScript debug logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
