* text=auto
# Keep CRLF bytes in the repository so GitHub ZIP downloads also run in cmd.exe.
*.cmd -text whitespace=cr-at-eol
*.ps1 text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
